{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "目标计划助手",
  "version": "0.2.0",
  "identifier": "com.luoke.goalplanassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "目标计划助手",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "label": "main",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "luoke",
    "shortDescription": "目标计划助手",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
